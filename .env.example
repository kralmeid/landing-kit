RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=hello@yourbrand.com
CONTACT_FORM_FROM_EMAIL=noreply@yourbrand.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry — all empty by default: error tracking stays silent until a DSN is set,
# and source-map upload is skipped unless SENTRY_AUTH_TOKEN is present.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
